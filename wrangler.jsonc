{
  "name": "kentshen",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only page routes go through the Worker (workers.dev → kentshen.com redirect).
    // Hashed JS/CSS and thumbnails are served straight from the asset layer, which
    // is free and does not count as a Worker request. Unlisted paths fall back to
    // index.html (SPA) without running the Worker either. Add a pattern here when
    // you add a new top-level page route.
    "run_worker_first": ["/", "/index.html", "/blog", "/blog/*", "/contact"],
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kentshen.com", "custom_domain": true }]
}
